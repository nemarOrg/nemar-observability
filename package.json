{
  "name": "nemar-observability",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml --env dev",
    "deploy": "wrangler deploy -c wrangler.toml",
    "deploy:dev": "wrangler deploy -c wrangler.toml --env dev",
    "db:migrate": "wrangler d1 migrations apply nemar-observability-db -c wrangler.toml",
    "db:migrate:dev": "wrangler d1 migrations apply nemar-observability-db-dev -c wrangler.toml --env dev",
    "db:migrate:local": "wrangler d1 migrations apply nemar-observability-db -c wrangler.toml --local",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "format": "biome format --write src/ test/",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0",
    "@hono/zod-validator": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20241112.0",
    "wrangler": "^4.85.0",
    "typescript": "^5.6.0"
  }
}
