[Unit]
Description=Run the NEMAR S3 storage collector twice daily

[Timer]
# S3 publishes a day's storage size at some point during the next UTC day, and
# the collector rejects a value older than the previous UTC day, so running
# through the small hours would report a failure before S3 has caught up.
# Two daytime runs instead: the second retries a failed first run.
OnCalendar=*-*-* 08:45:00 UTC
OnCalendar=*-*-* 14:45:00 UTC
Persistent=true
RandomizedDelaySec=2m
AccuracySec=1m
Unit=nemar-observability-storage.service

[Install]
WantedBy=timers.target
