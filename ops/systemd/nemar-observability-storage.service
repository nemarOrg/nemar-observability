[Unit]
Description=Collect the daily NEMAR S3 storage size for observability
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yahya
Group=yahya
Environment=HOME=/home/yahya
Environment=PATH=/home/yahya/.local/bin:/home/yahya/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=GIT_TERMINAL_PROMPT=0
WorkingDirectory=/opt/nemar-observability
TimeoutStartSec=10min
# Merging to main is the deploy: fetch the collector code before each run. The
# leading "-" keeps a failed pull (network, local edits) from blocking the
# collection; the run then uses the code already on disk.
ExecStartPre=-/usr/bin/git -C /opt/nemar-observability pull --ff-only --quiet origin main
ExecStart=/opt/nemar-observability/ops/with-collector-secrets.sh /opt/nemar-observability/scripts/push-s3-storage.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/nemar-observability
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
