[Unit]
Description=Collect the daily NEMAR S3 storage size for observability
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yahya
Group=yahya
Environment=HOME=/home/yahya
Environment=PATH=/home/yahya/.local/bin:/home/yahya/.bun/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/nemar-observability
ExecStart=/opt/nemar-observability/ops/with-collector-secrets.sh /opt/nemar-observability/scripts/push-s3-storage.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
